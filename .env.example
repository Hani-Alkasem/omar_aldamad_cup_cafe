DATABASE_URL=postgresql://itam:itam@localhost:5432/itam
# docker compose: database password for the full stack
POSTGRES_PASSWORD=change-me
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-32+-random-bytes
# Credential vault master key: openssl rand -base64 32. Losing it makes stored credentials unreadable.
VAULT_MASTER_KEY=
# During rotation: comma-separated old keys that may still open existing rows.
VAULT_PREVIOUS_KEYS=
# Time zone for discovery cron schedules.
DISCOVERY_TZ=UTC
API_PORT=4000
# web (server-side only; the browser never sees the token)
API_URL=http://localhost:4000/api/v1
API_TOKEN=
# Origin printed into QR labels. Set it in production: otherwise the request Host header is used.
PUBLIC_BASE_URL=https://itam.example.com

# Behind a reverse proxy: its hop count or subnet, so rate limits see real client IPs
TRUST_PROXY=

# webhooks / dispatcher
# Comma-separated CIDRs webhooks may reach despite being private (on-prem Jira, ServiceNow MID)
WEBHOOK_ALLOW_PRIVATE_CIDRS=
OUTBOX_RETENTION_DAYS=30

# discovery worker: from "cli.js create-service-client" (or the seed output)
WORKER_CLIENT_ID=
WORKER_CLIENT_SECRET=
# development fallback instead of client credentials
WORKER_TOKEN=
WORKER_CONCURRENCY=2
# Only inside a trusted overlay network: allows a plain-HTTP API_URL off loopback.
ALLOW_INSECURE_API=false

# single sign-on (API and web). Without OIDC_ISSUER the web app uses API_TOKEN (development only).
OIDC_ISSUER=
OIDC_CLIENT_ID=itam-web
# web only: the confidential client secret
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
OIDC_GROUPS_CLAIM=groups
OIDC_ROLE_MAP={"itam-admins":"admin","itam-network":"network_engineer","itam-dc-techs":"dc_technician","itam-auditors":"auditor"}
OIDC_SITE_MAP={}
OIDC_DEFAULT_ROLE=
SESSION_IDLE_MINUTES=120
SESSION_MAX_MINUTES=720

# observability
LOG_FORMAT=json
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_TOKEN=
GRAFANA_ADMIN_PASSWORD=
