{
  "name": "@itam/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json && node --enable-source-maps dist/main.js",
    "typecheck": "prisma generate >/dev/null && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy",
    "db:pull": "sh scripts/db-pull.sh",
    "seed": "tsx prisma/seed.ts",
    "token": "tsx scripts/dev-token.ts",
    "dispatcher": "node --enable-source-maps dist/dispatcher.js"
  },
  "dependencies": {
    "@itam/shared": "workspace:*",
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-express": "10.4.15",
    "@nestjs/swagger": "7.4.2",
    "@prisma/client": "6.2.1",
    "bullmq": "5.34.6",
    "cron-parser": "4.9.0",
    "ipaddr.js": "2.2.0",
    "jsonwebtoken": "9.0.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.24.1",
    "zod-to-json-schema": "3.24.1"
  },
  "devDependencies": {
    "@nestjs/testing": "10.4.15",
    "@swc/core": "1.10.1",
    "@types/express": "5.0.0",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.10.2",
    "@types/supertest": "6.0.2",
    "prisma": "6.2.1",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "unplugin-swc": "1.5.1",
    "vitest": "2.1.8"
  }
}
