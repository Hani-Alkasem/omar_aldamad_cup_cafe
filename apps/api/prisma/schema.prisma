/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model ip_addresses {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ip            String         @db.Inet
  subnet_id     String         @db.Uuid
  vrf_id        String?        @db.Uuid
  asset_id      String?        @db.Uuid
  port_id       String?        @db.Uuid
  status        ip_status      @default(assigned)
  dns_name      String?
  description   String?
  last_seen_at  DateTime?      @db.Timestamptz(6)
  created_at    DateTime       @default(now()) @db.Timestamptz(6)
  updated_at    DateTime       @default(now()) @db.Timestamptz(6)
  assets        assets?        @relation(fields: [asset_id], references: [id], onUpdate: NoAction)
  network_ports network_ports? @relation(fields: [port_id], references: [id], onUpdate: NoAction)
  subnets       subnets        @relation(fields: [subnet_id], references: [id], onUpdate: NoAction)
  vrfs          vrfs?          @relation(fields: [vrf_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([asset_id])
  @@index([ip(ops: InetOps)], map: "ip_addresses_ip_gist", type: Gist)
  @@index([port_id])
  @@index([subnet_id, ip], map: "ip_addresses_subnet_ip_idx")
}

model job_credentials {
  job_id         String         @db.Uuid
  credential_id  String         @db.Uuid
  position       Int            @db.SmallInt
  credentials    credentials    @relation(fields: [credential_id], references: [id], onUpdate: NoAction)
  discovery_jobs discovery_jobs @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([job_id, credential_id])
  @@unique([job_id, position])
  @@index([credential_id], map: "job_credentials_credential_idx")
}

