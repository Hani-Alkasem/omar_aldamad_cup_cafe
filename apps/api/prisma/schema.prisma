generator client {
  provider      = "prisma-client-js"
  // native for development; debian-openssl-3.0.x is what the container images run.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model application_members {
  application_id String       @db.Uuid
  asset_id       String       @db.Uuid
  role           String?
  applications   applications @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assets         assets       @relation(fields: [asset_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([application_id, asset_id])
  @@index([asset_id], map: "application_members_asset_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model applications {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  description         String?
  owner               String?
  criticality         app_criticality       @default(tier2)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  application_members application_members[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model asset_components {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  asset_id      String   @db.Uuid
  kind          String
  slot          String?
  manufacturer  String?
  model         String?
  serial_number String?
  capacity      Decimal? @db.Decimal
  attributes    Json     @default("{}")
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  assets        assets   @relation(fields: [asset_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([asset_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model asset_financials {
  asset_id            String              @id @db.Uuid
  purchase_order_id   String?             @db.Uuid
  purchase_date       DateTime?           @db.Date
  in_service_date     DateTime?           @db.Date
  purchase_cost       Decimal?            @db.Decimal(14, 2)
  currency            String              @default("USD") @db.Char(3)
  depreciation_method depreciation_method @default(straight_line)
  useful_life_months  Int?
  salvage_value       Decimal             @default(0) @db.Decimal(14, 2)
  disposal_date       DateTime?           @db.Date
  updated_at          DateTime            @default(now()) @db.Timestamptz(6)
  assets              assets              @relation(fields: [asset_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  purchase_orders     purchase_orders?    @relation(fields: [purchase_order_id], references: [id], onUpdate: NoAction)

  @@index([purchase_order_id], map: "asset_financials_po_idx")
}

/// This table contains exclusion constraints and requires additional setup for migrations. Visit https://pris.ly/d/exclusion-constraints for more info.
model asset_rack_occupancy {
  asset_id String                   @db.Uuid
  rack_id  String                   @db.Uuid
  face     rack_face
  u_range  Unsupported("int4range")
  assets   assets                   @relation(fields: [asset_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  racks    racks                    @relation(fields: [rack_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([asset_id, face])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model assets {
  id                                                        String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                                                      String
  asset_tag                                                 String?
  serial_number                                             String?
  type                                                      asset_type
  status                                                    asset_status            @default(active)
  model_id                                                  String?                 @db.Uuid
  parent_id                                                 String?                 @db.Uuid
  rack_id                                                   String?                 @db.Uuid
  start_u                                                   Int?                    @db.SmallInt
  size_u                                                    Int                     @default(1) @db.SmallInt
  face                                                      rack_face?
  depth                                                     mount_depth             @default(full)
  power_draw_w                                              Int?
  custom_fields                                             Json                    @default("{}")
  created_at                                                DateTime                @default(now()) @db.Timestamptz(6)
  updated_at                                                DateTime                @default(now()) @db.Timestamptz(6)
  system_uuid                                               String?                 @db.Uuid
  last_discovered_at                                        DateTime?               @db.Timestamptz(6)
  application_members                                       application_members[]
  asset_components                                          asset_components[]
  asset_financials                                          asset_financials?
  asset_rack_occupancy                                      asset_rack_occupancy[]
  hardware_models                                           hardware_models?        @relation(fields: [model_id], references: [id], onUpdate: NoAction)
  assets                                                    assets?                 @relation("assetsToassets", fields: [parent_id], references: [id], onUpdate: NoAction)
  other_assets                                              assets[]                @relation("assetsToassets")
  racks                                                     racks?                  @relation(fields: [rack_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  ci_relationships_ci_relationships_source_asset_idToassets ci_relationships[]      @relation("ci_relationships_source_asset_idToassets")
  ci_relationships_ci_relationships_target_asset_idToassets ci_relationships[]      @relation("ci_relationships_target_asset_idToassets")
  contract_assets                                           contract_assets[]
  discovery_results                                         discovery_results[]
  ip_addresses                                              ip_addresses[]
  maintenance_schedules                                     maintenance_schedules[]
  network_ports                                             network_ports[]
  power_ports                                               power_ports[]

  @@index([custom_fields(ops: JsonbPathOps)], map: "assets_custom_fields_gin", type: Gin)
  @@index([model_id])
  @@index([parent_id])
  @@index([type, status])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model audit_logs {
  id             BigInt       @id @default(autoincrement())
  entity         String
  entity_id      String       @db.Uuid
  action         audit_action
  before         Json?
  after          Json?
  changed_fields String[]     @default([])
  user_id        String?      @db.Uuid
  request_id     String?
  at             DateTime     @default(now()) @db.Timestamptz(6)
  users          users?       @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([entity, entity_id, at(sort: Desc)], map: "audit_logs_entity_idx")
  @@index([user_id, at(sort: Desc)], map: "audit_logs_user_idx")
}

model buildings {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  site_id    String   @db.Uuid
  name       String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  sites      sites    @relation(fields: [site_id], references: [id], onUpdate: NoAction)
  rooms      rooms[]

  @@unique([site_id, name])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cables {
  id                                            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  a_port_id                                     String        @unique(map: "cables_a_port_key") @db.Uuid
  b_port_id                                     String        @unique(map: "cables_b_port_key") @db.Uuid
  media                                         cable_media   @default(cat6)
  label                                         String?
  length_m                                      Decimal?      @db.Decimal(6, 2)
  circuit_id                                    String?
  created_at                                    DateTime      @default(now()) @db.Timestamptz(6)
  updated_at                                    DateTime      @default(now()) @db.Timestamptz(6)
  network_ports_cables_a_port_idTonetwork_ports network_ports @relation("cables_a_port_idTonetwork_ports", fields: [a_port_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  network_ports_cables_b_port_idTonetwork_ports network_ports @relation("cables_b_port_idTonetwork_ports", fields: [b_port_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ci_relationships {
  id                                              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source_asset_id                                 String            @db.Uuid
  target_asset_id                                 String            @db.Uuid
  relationship_type                               relationship_type
  attributes                                      Json              @default("{}")
  created_at                                      DateTime          @default(now()) @db.Timestamptz(6)
  source                                          String            @default("manual")
  first_seen_at                                   DateTime          @default(now()) @db.Timestamptz(6)
  last_seen_at                                    DateTime          @default(now()) @db.Timestamptz(6)
  observation_count                               Int               @default(1)
  assets_ci_relationships_source_asset_idToassets assets            @relation("ci_relationships_source_asset_idToassets", fields: [source_asset_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assets_ci_relationships_target_asset_idToassets assets            @relation("ci_relationships_target_asset_idToassets", fields: [target_asset_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([source_asset_id, target_asset_id, relationship_type])
  @@index([source_asset_id, relationship_type], map: "ci_relationships_source_idx")
  @@index([target_asset_id, relationship_type], map: "ci_relationships_target_idx")
}

model contract_assets {
  contract_id String    @db.Uuid
  asset_id    String    @db.Uuid
  assets      assets    @relation(fields: [asset_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contracts   contracts @relation(fields: [contract_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([contract_id, asset_id])
  @@index([asset_id], map: "contract_assets_asset_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model contracts {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendor_id       String            @db.Uuid
  contract_type   contract_type
  contract_number String
  start_date      DateTime          @db.Date
  end_date        DateTime          @db.Date
  cost            Decimal?          @db.Decimal(14, 2)
  currency        String            @default("USD") @db.Char(3)
  auto_renew      Boolean           @default(false)
  notice_days     Int               @default(30)
  notes           String?
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  contract_assets contract_assets[]
  vendors         vendors           @relation(fields: [vendor_id], references: [id], onUpdate: NoAction)

  @@unique([vendor_id, contract_number])
  @@index([end_date])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model credentials {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
