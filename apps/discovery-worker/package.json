{
  "name": "@itam/discovery-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Agentless discovery worker: SNMP and SSH collectors driven by BullMQ, reporting to the ITAM API",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "dev": "tsc -p tsconfig.build.json && node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lab": "tsx scripts/lab.ts"
  },
  "dependencies": {
    "@itam/shared": "workspace:*",
    "bullmq": "5.34.6",
    "ipaddr.js": "2.2.0",
    "net-snmp": "3.20.0",
    "ssh2": "1.16.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/ssh2": "1.15.1",
    "typescript": "5.6.3",
    "vitest": "2.1.8",
    "tsx": "4.19.2"
  }
}
